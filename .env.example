# ===================================================
# WalkBuddy Backend 환경 변수 설정 템플릿 (.env.example)
# ===================================================
# 실제 환경변수 값은 .env 파일에 작성하며, .env 파일은 git에 커밋하지 않습니다.

# 1. 서버 기본 설정
PORT=3000
NODE_ENV=development

# 2. PostgreSQL 데이터베이스 연결 설정
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=walkbuddy
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false
# 또는 전체 연결 문자열 사용 시
# DATABASE_URL=postgresql://user:password@localhost:5432/walkbuddy

# 3. JWT 인증 시크릿 키
JWT_SECRET=your_jwt_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_VERIFY_SECRET=your_jwt_verify_secret_key

# 4. 한국관광공사 공공데이터 API
# Odii(오디) 관광지 오디오 가이드정보 API 키
ODII_API_KEY=your_odii_api_key_here
# 한국관광공사 TourAPI / 두루누비 API 키
TOURAPI_SERVICE_KEY=your_tourapi_service_key_here
DURUNUBI_SERVICE_KEY=your_durunubi_service_key_here
KOR_WITH_SERVICE_KEY=your_kor_with_service_key_here
KOR_PET_TOUR_SERVICE_KEY=your_kor_pet_tour_service_key_here

# 5. 카카오 API
KAKAO_REST_API_KEY=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback

# 6. Tmap API (도보 경로 및 거리 계산)
TMAP_API_KEY=your_tmap_api_key

# 7. Google Cloud API (Gemini & TTS)
GEMINI_API_KEY=your_gemini_api_key
GOOGLE_TTS_API_KEY=your_google_tts_api_key

# 8. AWS S3 (음성 파일 및 후기 사진 스토리지)
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=your_s3_bucket_name

# 9. 메일 발송 설정 (Nodemailer)
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_email_app_password
MAIL_FROM="WalkBuddy <noreply@walkbuddy.com>"
