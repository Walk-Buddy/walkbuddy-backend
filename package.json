{
  "name": "trail-course-backend",
  "version": "1.0.0",
  "description": "Trail course backend API",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "db": "node db/run-sql.js db/reset.sql && node db/run-sql.js db/schema.sql && node db/generate-erd-data.js && npm --prefix db/erd-viewer run dev",
    "db:apply": "node db/run-sql.js db/reset.sql && node db/run-sql.js db/schema.sql && node db/generate-erd-data.js",
    "db:migrate": "node db/run-sql.js",
    "import:durunubi": "node scripts/import-durunubi-courses.js",
    "erd:gen": "node db/generate-erd-data.js",
    "erd:dev": "npm run erd:gen && npm --prefix db/erd-viewer run dev",
    "db:seed": "node db/run-sql.js db/seed.sql"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.7",
    "pg": "^8.11.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
